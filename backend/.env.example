# =============================================================================
# Backend environment configuration
# =============================================================================
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — NEVER commit real secrets.

# ----- Server -----
PORT=3000
NODE_ENV=development

# ----- Database (matches docker-compose.yml) -----
DATABASE_URL=postgres://rag_user:rag_password@localhost:5432/rag_chatbot

# ----- JWT -----
# Generate a strong random secret for production:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ----- LLM provider -----
# 'ollama' (default) — free, local, no AWS account needed. Requires Ollama
#   running (https://ollama.com) with these models pulled:
#     ollama pull mxbai-embed-large
#     ollama pull llama3.1
# 'bedrock' — requires a working AWS account with Bedrock model access.
LLM_PROVIDER=ollama

# ----- Ollama (used when LLM_PROVIDER=ollama) -----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
OLLAMA_GENERATION_MODEL=llama3.1

# ----- AWS Bedrock (used when LLM_PROVIDER=bedrock) -----
# These credentials must have bedrock:InvokeModel permission for the models below
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# Bedrock model IDs (exact strings from the Bedrock console)
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_GENERATION_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0

# ----- Reverse proxy -----
# Number of reverse proxies in front of this app, used to derive req.ip for
# rate limiting. 0 for local dev. Set to 1 behind nginx / ALB / Render /
# Heroku. NEVER set this to "true" — that trusts a client-spoofable
# X-Forwarded-For header and defeats rate limiting entirely.
TRUST_PROXY=0

# ----- CORS -----
# Comma-separated list of allowed origins for the frontend
CORS_ORIGINS=http://localhost:5173
