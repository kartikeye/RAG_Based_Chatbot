# =============================================================================
# Backend environment configuration
# =============================================================================
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — NEVER commit real secrets.

# ----- Server -----
PORT=3000
NODE_ENV=development

# ----- Database (matches docker-compose.yml) -----
DATABASE_URL=postgres://rag_user:rag_password@localhost:5432/rag_chatbot

# ----- JWT -----
# Generate a strong random secret for production:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ----- AWS Bedrock -----
# These credentials must have bedrock:InvokeModel permission for the models below
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# Bedrock model IDs (exact strings from the Bedrock console)
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_GENERATION_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0

# ----- CORS -----
# Comma-separated list of allowed origins for the frontend
CORS_ORIGINS=http://localhost:5173
